    "typecheck": "tsc -p tsconfig.json",
    "pdf": "node scripts/pdf.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
